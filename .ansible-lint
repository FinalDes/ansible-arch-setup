---
# .ansible-lint
profile: production # Enforce strict production standards
strict: true # Fail the build on any warnings, not just errors
kinds:
  - inventory: "**/molecule/*/inventory.yml"
# Stop linting third-party roles downloaded from Galaxy
exclude_paths:
  - .ansible/
  - .github/
  - .venv/
  - .vscode/
  - ansible_collections/
  - "README.md"

# # Ignore rules that cause too much noise for your specific team
# skip_list:
#   - experimental # Don't fail builds based on experimental rules
